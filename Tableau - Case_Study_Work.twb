      <aliases enabled='yes' />
      <column caption='Base Revenue' datatype='real' name='[BaseRevenue]' role='measure' type='quantitative' />
      <column caption='Distinct Count Orders' datatype='integer' name='[Calculation_1623183934296064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order ID])' />
      </column>
      <column caption='Count Payment Providers' datatype='integer' name='[Calculation_1623183935434754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Provider])' />
      </column>
      <column caption='Profit' datatype='real' name='[Calculation_1623184012914691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum(Revenue) - Sum(Cost)' />
      </column>
      <column caption='Gross Revenue' datatype='real' name='[Calculation_1623184013307908]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([BaseRevenue])' />
      </column>
      <column caption='Discount' datatype='real' name='[Calculation_1623184018427910]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([BaseRevenue]) - Sum([Revenue])' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Calculation_1623184021057543]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1623184330739727] / [Calculation_1623184331067408]' />
      </column>
      <column caption='Distinct Count of Customers' datatype='integer' name='[Calculation_1623184315592712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([CustomerId])' />
      </column>
      <column caption='Sum of Quantity' datatype='integer' name='[Calculation_1623184316022794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([Quantity])' />
      </column>
      <column caption='Sum of Units' datatype='integer' name='[Calculation_1623184316178443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([Units])' />
      </column>
      <column caption='AVG of Order' datatype='real' name='[Calculation_1623184316604429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Revenue])/[Calculation_1623183934296064]' />
      </column>
      <column caption='% Profit Ratio - Row Level' datatype='real' name='[Calculation_1623184316780558]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Revenue]-[Cost])/[Revenue]' />
      </column>
      <column caption='Sum of Profit' datatype='real' name='[Calculation_1623184330739727]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([Revenue]) - Sum([Cost])' />
      </column>
      <column caption='Sum of Net Revenue' datatype='real' name='[Calculation_1623184331067408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([Revenue])' />
      </column>
      <column caption='Is Promo Order' datatype='string' name='[Calculation_1623184647655447]' role='dimension' type='nominal'>

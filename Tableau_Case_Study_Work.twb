  <worksheets>
    <worksheet name='BANS'>
      <table>
        <view>
          <datasources>
            <datasource caption='factOrder+' name='federated.0fapkmm18v981x12m4qw90ud8zf9' />
          </datasources>
          <datasource-dependencies datasource='federated.0fapkmm18v981x12m4qw90ud8zf9'>
            <column caption='Base Revenue' datatype='real' name='[BaseRevenue]' role='measure' type='quantitative' />
            <column caption='Distinct Count Orders' datatype='integer' name='[Calculation_1623183934296064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Order ID])' />
            </column>
            <column caption='Profit' datatype='real' name='[Calculation_1623184012914691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(Revenue) - Sum(Cost)' />
            </column>
            <column caption='Discount' datatype='real' name='[Calculation_1623184018427910]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([BaseRevenue]) - Sum([Revenue])' />
            </column>
            <column caption='Profit Margin' datatype='real' name='[Calculation_1623184021057543]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1623184330739727] / [Calculation_1623184331067408]' />
